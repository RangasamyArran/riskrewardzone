# OpenAlgo Connection Settings
OPENALGO_HOST=http://127.0.0.1:5000
OPENALGO_API_KEY=your_openalgo_api_key_here

# Default Strategy Settings (180s = 3 mins, matching NSE OI broadcast cycle)
DEFAULT_UNDERLYING=NIFTY
DEFAULT_EXCHANGE=NSE_INDEX
STRIKE_COUNT=5
POLL_INTERVAL_SECONDS=180

# Risk & Anti-Theta Guardrails
STOP_LOSS_PCT=18.0
TARGET_1_PCT=25.0
TARGET_2_PCT=45.0
THETA_TIME_STOP_MINUTES=15
THETA_TIME_STOP_MIN_GAIN_PCT=5.0
MAX_TRADES_PER_DAY=3
MAX_CONSECUTIVE_LOSSES=2

# ---------------------------------------------------------------------------
# Instant Trade Setup Alert Settings (Triggers when 6/6 Setup occurs)
# Supported ALERT_PROVIDER / WHATSAPP_PROVIDER values:
#   1. "gmail"     (Recommended: 100% Free & Official Google SMTP using a 16-char App Password)
#   2. "webhook"   (Any custom webhook URL: Green-API, n8n, Make, Slack, Discord)
#   3. "callmebot" (Personal WhatsApp gateway)
#   4. "meta"      (Official Meta WhatsApp Cloud API)
# ---------------------------------------------------------------------------
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=gmail

# Gmail Settings (Get your 16-char App Password at: https://myaccount.google.com/apppasswords)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Optional: Leave blank to send to yourself (GMAIL_USER), or comma-separate multiple emails
GMAIL_TO=

# Optional: Only if using callmebot / meta / webhook
WHATSAPP_PHONE=+919876543210
WHATSAPP_API_KEY=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_URL=
